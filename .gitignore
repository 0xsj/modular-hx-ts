# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
.turbo/
.vite/

# Environment — .env.example is committed, .env never is
.env
.env.local
.env.*.local

# Local state
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Editors and local tooling
.idea/
.vscode/
.eslintcache

# What `make e2e` writes: a journal of every exchange the journey made. It is
# meant to be read after a run, not committed — every id and timestamp in it
# changes on every run, so a committed copy is a diff nobody can review.
artifacts/

# Local working files — not part of the published blueprint
CLAUDE.md
STATUS.md
.claude/
drafts/
scratch/
