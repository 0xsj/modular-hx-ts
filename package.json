{
  "name": "modular-hx-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A blueprint: hexagonal contexts over a layered shared kernel, in TypeScript.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "migrate": "tsx src/main.ts migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.6",
    "ts-morph": "28.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.12.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
